# Cấu hình nginx phục vụ giao diện. Biến ${API_ORIGIN} và ${MAP_ORIGIN} được điền khi container khởi động.
server_tokens off;

map $sent_http_content_type $cache_control {
    default                 "no-cache";
    ~^text/html             "no-cache";
    ~^text/plain            "public, max-age=3600";
    ~^application/xml       "public, max-age=3600";
}

server {
    listen 80;
    root /usr/share/nginx/html;

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json application/xml image/svg+xml application/manifest+json;

    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; worker-src 'self' blob:; child-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: ${MAP_ORIGIN}; connect-src 'self' ${API_ORIGIN} ${MAP_ORIGIN}; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), camera=(), microphone=()" always;
    add_header Cache-Control $cache_control always;

    types {
        application/manifest+json webmanifest;
    }

    location = /llms.txt      { default_type "text/plain; charset=utf-8"; }
    location = /llms-full.txt { default_type "text/plain; charset=utf-8"; }
    location = /robots.txt    { default_type "text/plain; charset=utf-8"; }

    location /assets/ {
        # Tên file có hash → cache vĩnh viễn
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    location / {
        try_files $uri /index.html;
    }
}
