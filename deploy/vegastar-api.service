[Unit]
Description=VegaStar vessel chat API
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=exec
User=vegastar
Group=vegastar
WorkingDirectory=/opt/vegastar
EnvironmentFile=/opt/vegastar/.env
ExecStart=/opt/vegastar/.venv/bin/uvicorn vessel_chat.api.app:app \
  --host 127.0.0.1 --port 8011 --proxy-headers --no-server-header --workers 1
Restart=always
RestartSec=5
# Giới hạn quyền của tiến trình
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/vegastar/results
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
MemoryMax=900M

[Install]
WantedBy=multi-user.target
