# =====================================================================
# Cấu hình Vessel Chat. Sao chép thành `.env` rồi điền giá trị.
# Không commit file .env (đã có trong .gitignore).
# =====================================================================

# ---------- PostgreSQL (docker compose) ----------
POSTGRES_USER=vessel
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vessel
# Cổng DB mở ra máy host
DB_HOST_PORT=5432

# Chuỗi kết nối khi chạy API/script trực tiếp trên máy host.
# (Trong docker compose, service `api` tự dùng host `db`.)
DATABASE_URL=postgresql://vessel:change-me@localhost:5432/vessel
# Database dùng cho pytest (được tạo sẵn khi container DB khởi tạo lần đầu)
TEST_DATABASE_URL=postgresql://vessel:change-me@localhost:5432/vessel_test

# ---------- LLM / Embedding ----------
OPENAI_API_KEY=sk-...
# Để trống nếu dùng OpenAI; đặt URL nếu dùng endpoint tương thích (vLLM, Ollama /v1, Azure proxy…)
# OPENAI_BASE_URL=http://localhost:11434/v1
LLM_MODEL=gpt-4o-mini
# Nhiệt độ thấp để câu trả lời bám dữ liệu
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=60
# Số lần SDK tự thử lại khi OpenAI lỗi tạm thời / 429 (lùi theo cấp số nhân)
LLM_MAX_RETRIES=4
# Số token tối đa cho bản tóm tắt hội thoại
SUMMARY_MAX_TOKENS=600
EMBEDDING_MODEL=text-embedding-3-small
# Số chiều vector — phải khớp model embedding (đổi thì phải tạo lại bảng memory_chunks)
EMBEDDING_DIM=1536

# ---------- Dữ liệu ----------
# Thư mục chứa 4 file CSV (vessels, ais_positions, dark_gaps, ownership)
DATA_DIR=./data

# ---------- Bộ nhớ hội thoại ----------
# Số lượt (1 câu hỏi + trả lời) gần nhất giữ nguyên văn trong prompt.
# Giảm xuống 2 để kiểm tra bộ nhớ dài hạn nhanh.
MEMORY_WINDOW_TURNS=6
# Giới hạn token cho phần nguyên văn (cắt bớt lượt cũ nếu vượt)
MEMORY_WINDOW_MAX_TOKENS=6000
# Kết quả tool của các lượt cũ trong cửa sổ bị rút gọn về tối đa số ký tự này
MEMORY_TOOL_RESULT_MAX_CHARS=2500
# Số đoạn ký ức lấy từ vector DB mỗi lượt
MEMORY_TOP_K=4
# Ngưỡng cosine similarity tối thiểu để dùng một đoạn ký ức
MEMORY_MIN_SCORE=0.25
# Thời gian tối đa chờ tác vụ nén bộ nhớ của lượt trước trước khi trả lời lượt mới (giây)
MEMORY_COMPACTION_WAIT_SECONDS=20
# Phát sự kiện SSE `memory` (ký ức đã truy xuất) để kiểm tra/debug
DEBUG_MEMORY_EVENTS=true

# ---------- Vòng lặp tool ----------
# Số vòng gọi tool tối đa trong một lượt
MAX_TOOL_ITERATIONS=8
# Số dòng tối đa trong kết quả tool gửi cho LLM
TOOL_RESULT_MAX_ROWS=30

# ---------- Xử lý dữ liệu AIS ----------
# Điểm GPS có tốc độ suy ra tới cả điểm trước và sau vượt ngưỡng này bị coi là nhiễu
MAX_PLAUSIBLE_SPEED_KNOTS=50
# Khoảng không có điểm dài hơn (giờ) được coi là "khe" và tách đoạn hành trình
TRACK_GAP_SPLIT_HOURS=3
# Lệch tối đa (phút) giữa thời điểm hỏi và điểm gần nhất để coi là "có dữ liệu"
POSITION_MAX_OFFSET_MINUTES=60
# Chỉ nội suy khi hai điểm bao quanh cách nhau không quá (phút)
INTERPOLATION_MAX_GAP_MINUTES=180
# Ngưỡng trigram similarity khi tìm tên tàu / tên công ty
VESSEL_MATCH_THRESHOLD=0.35
COMPANY_MATCH_THRESHOLD=0.45
# Giới hạn cho truy vấn nhiều hành trình
MULTI_TRACK_MAX_VESSELS=1000
MULTI_TRACK_MAX_POINTS=60000
MAX_TRACKS_PER_PAGE=100

# ---------- Guardrails ----------
# Điểm heuristic prompt injection từ mức này trở lên → chặn (không gọi LLM); thấp hơn nhưng > 0 → cảnh báo
GUARDRAIL_INJECTION_BLOCK_SCORE=1.0
# Kiểm duyệt nội dung đầu vào bằng OpenAI Moderation (miễn phí)
GUARDRAIL_MODERATION_ENABLED=true
GUARDRAIL_MODERATION_MODEL=omni-moderation-latest
# Moderation lỗi: true = vẫn cho qua (ưu tiên sẵn sàng), false = chặn (ưu tiên an toàn)
GUARDRAIL_MODERATION_FAIL_OPEN=true
# Đối chiếu mọi con số trong câu trả lời với dữ liệu đã truy vấn
GUARDRAIL_GROUNDING_ENABLED=true

# ---------- Kho tri thức (RAG) ----------
# Thư mục tài liệu Markdown nghiệp vụ
KNOWLEDGE_DIR=knowledge
# Tự đồng bộ kho tri thức khi API khởi động (chỉ nhúng đoạn mới/đã sửa)
RAG_AUTO_INGEST=true
# Độ dài tối đa mỗi đoạn (ký tự)
RAG_CHUNK_MAX_CHARS=1400
# Số ứng viên lấy từ mỗi nhánh tìm kiếm (vector, từ khoá) trước khi gộp RRF
RAG_CANDIDATES=20
# Số đoạn trả cho LLM
RAG_TOP_K=4
# Cosine tối thiểu với đoạn chỉ khớp theo vector (đoạn khớp từ khoá luôn được giữ)
RAG_MIN_SCORE=0.2

# ---------- Cache & chi phí ----------
# Cache kết quả tool trong tiến trình (dữ liệu tàu là tĩnh); 0 = tắt
TOOL_CACHE_TTL_SECONDS=3600
TOOL_CACHE_MAX_ENTRIES=512
# Đơn giá để ước tính chi phí trong log/metrics (USD / 1M token)
PRICE_INPUT_PER_M=0.15
PRICE_OUTPUT_PER_M=0.60

# ---------- Bảo mật ----------
# Danh sách API key phân tách dấu phẩy; để trống = không yêu cầu xác thực (chỉ dùng khi demo nội bộ)
API_KEYS=
# Giới hạn yêu cầu mỗi phút theo API key hoặc IP (0 = tắt)
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_API_PER_MINUTE=300
# Tin X-Forwarded-For (chỉ bật khi API đứng sau reverse proxy tin cậy)
TRUST_PROXY_HEADERS=false
# Kích thước body tối đa (byte)
MAX_REQUEST_BYTES=64000
# Bật endpoint /metrics (Prometheus) — nên chặn ở proxy nếu public
METRICS_ENABLED=true
# Log dạng JSON một dòng (thuận tiện cho Loki/ELK)
LOG_JSON=true

# ---------- Hạ tầng ----------
# Timeout mỗi câu SQL (ms)
DB_STATEMENT_TIMEOUT_MS=15000
DB_POOL_MIN=1
DB_POOL_MAX=10
# Danh sách origin được gọi API từ trình duyệt, phân tách bằng dấu phẩy
CORS_ORIGINS=http://localhost:5173
API_HOST=0.0.0.0
API_PORT=8000
API_HOST_PORT=8000

# ---------- Frontend (dùng khi build) ----------
VITE_API_BASE_URL=http://localhost:8000
# Style bản đồ nền MapLibre (không cần key)
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# Địa chỉ công khai của trang (canonical, Open Graph, sitemap, llms.txt)
VITE_SITE_URL=http://localhost:5173
# Tuỳ chọn: khoá API gửi kèm từ trình duyệt khi backend bật API_KEYS (khoá sẽ nằm trong bundle — chỉ cho demo)
VITE_API_KEY=
WEB_HOST_PORT=5173
# Nguồn được phép trong Content-Security-Policy của nginx (khớp VITE_API_BASE_URL và máy chủ bản đồ)
API_ORIGIN=http://localhost:8000
MAP_ORIGIN=https://tiles.openfreemap.org
